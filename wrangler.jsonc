{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayan-whatsapp-archive-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "keep_vars": true,
  "secrets": {
    "required": [
      "META_VERIFY_TOKEN",
      "META_APP_SECRET",
      "WHATSAPP_ACCESS_TOKEN",
      "WHATSAPP_PHONE_NUMBER_ID",
      "GEMINI_API_KEY",
      "GEMINI_FILE_SEARCH_STORE"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "CHAT_HISTORY"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOK_QUEUE",
        "queue": "dayan-whatsapp-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "dayan-whatsapp-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  }
}
